# Totally not generated by DeepSeek out of my old nginx configs

<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteCond %{REQUEST_URI} ^/(config|data|incl)/ [NC]
	RewriteRule ^ - [F]

	RewriteCond %{REQUEST_URI} \.json$ [NC]
	RewriteRule ^ - [F]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^sfx/(.+)$ sfx/handler.php?request=$1 [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^music/(.+)$ music/handler.php?request=$1 [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/clan/(.+)$ dashboard/clan/index.php?id=$1 [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/profile/(.+)$ dashboard/profile/index.php?id=$1 [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/messenger/(.+)$ dashboard/messenger/index.php?id=$1 [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/browse/levels/(.+)$ dashboard/browse/levels.php?id=$1 [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/browse/lists/(.+)$ dashboard/browse/lists.php?id=$1 [L,QSA]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/browse/mappacks/(.+)$ dashboard/browse/mappacks.php?id=$1 [L,QSA]
	
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/browse/gauntlets/(.+)$ dashboard/browse/gauntlets.php?id=$1 [L,QSA]
	
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/browse/accounts/(.+)$ dashboard/browse/accounts.php?id=$1 [L,QSA]
	
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/browse/songs/(.+)$ dashboard/browse/songs.php?id=$1 [L,QSA]
	
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/browse/sfxs/(.+)$ dashboard/browse/sfxs.php?id=$1 [L,QSA]
	
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^dashboard/mod/roles/(.+)$ dashboard/mod/roles.php?id=$1 [L,QSA]
	
	# General dashboard page rewrites (without parameters) - add .php if file doesn't exist
	RewriteCond %{REQUEST_FILENAME}.php -f
	RewriteCond %{REQUEST_FILENAME} !^.*/.*\..*$
	RewriteRule ^dashboard/(.+)$ dashboard/$1.php [L,QSA]
	
	# General .php rewrite for any URL that doesn't have an extension and file doesn't exist
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !^.*/.*\..*$
	RewriteCond %{REQUEST_FILENAME}.php -f
	RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

# Security headers
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set X-XSS-Protection "1; mode=block"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent access to hidden files and directories (except .well-known)
<FilesMatch "^\.(?!well-known)">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Cache control for static assets
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot|otf)$">
	<IfModule mod_headers.c>
		Header set Cache-Control "max-age=31536000, public, immutable"
	</IfModule>
</FilesMatch>

# No cache for dynamic content
<FilesMatch "\.(php|html)$">
	<IfModule mod_headers.c>
		Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
		Header set Pragma "no-cache"
		Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
	</IfModule>
</FilesMatch>

# Gzip compression for text-based files
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/plain
	AddOutputFilterByType DEFLATE text/html
	AddOutputFilterByType DEFLATE text/xml
	AddOutputFilterByType DEFLATE text/css
	AddOutputFilterByType DEFLATE text/javascript
	AddOutputFilterByType DEFLATE application/xml
	AddOutputFilterByType DEFLATE application/xhtml+xml
	AddOutputFilterByType DEFLATE application/rss+xml
	AddOutputFilterByType DEFLATE application/javascript
	AddOutputFilterByType DEFLATE application/x-javascript
	AddOutputFilterByType DEFLATE application/json
</IfModule>