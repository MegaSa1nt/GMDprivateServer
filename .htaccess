RewriteEngine On

# Block access to sensitive directories
RewriteCond %{REQUEST_URI} ^/(config|data|incl)/ [NC]
RewriteRule ^ - [F]

# Block direct access to JSON files
RewriteCond %{REQUEST_URI} \.json$ [NC]
RewriteRule ^ - [F]

# ===== SPECIFIC RULES (with parameters) MUST COME FIRST =====

# Media handlers
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sfx/(.+)$ sfx/handler.php?request=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^music/(.+)$ music/handler.php?request=$1 [L,QSA]

# Dynamic pages with ID parameters
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^dashboard/clan/(.+)$ dashboard/clan/index.php?id=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^dashboard/profile/(.+)$ dashboard/profile/index.php?id=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^dashboard/messenger/(.+)$ dashboard/messenger/index.php?id=$1 [L,QSA]

# Browse section (handles paths with two segments like /browse/levels/25)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^dashboard/browse/(levels|lists|mappacks|gauntlets|accounts|songs|sfxs)/(.+)$ dashboard/browse/$1.php?id=$2 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^dashboard/mod/roles/(.+)$ dashboard/mod/roles.php?id=$1 [L,QSA]

# ===== GENERIC RULE (for static pages without parameters) =====
# Adds .php extension only for URLs that correspond to existing .php files
# and have no trailing slash

# Match URLs with 1 segment (e.g., /dashboard)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)$ $1.php [L]

# Match URLs with 2 segments (e.g., /dashboard/account)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/([^/]+)$ $1/$2.php [L]

# Match URLs with 3 segments (e.g., /dashboard/account/levels)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/([^/]+)/([^/]+)$ $1/$2/$3.php [L]